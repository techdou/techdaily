# ========================================
# TechDaily .gitignore
# ========================================

# === 秘密 / 凭证（绝不入库） ===
.env
.env.*
*.key
*.pem
*.token
*.apikey
credentials.json
secrets.json
*.secret
secrets/

# === 本地开发状态（不入库） ===
output/            # 每日本地构建产物（HTML/MP3/TXT）
__pycache__/
*.pyc
*.pyo
*.egg-info/
state.json
*.state
*.local
config.local.json
deploy.local.sh

# === 内部文档 / Agent 配置（不入库，防内部信息泄漏） ===
SKILL.md           # OpenClaw skill 说明书（含部署链路细节）
*.notes.md
memory/
.dreams/

# === 编辑器 / IDE / 工具配置目录 ===
.vscode/
.idea/
.cursor/
.aider*
.claude/
.copilot/
.fleet/
*.swp
*.swo
*~

# === OS ===
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# === 临时文件 ===
*.tmp
*.bak
*.log
*.bak.*
/tmp/
